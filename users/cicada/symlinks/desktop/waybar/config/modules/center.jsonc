{
  "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M %d %B %Y}",
    "on-click-right": "hyprctl dispatch exec 'alacritty --class=peaclock -e peaclock'",
    "calendar": {
      "mode": "year",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "format": {
        "months": "<span color='#F5F5F5'><b>{}</b></span>",
        "days": "<span color='#F5F5F5'><b>{}</b></span>",
        "weeks": "<span color='#F5F5F5'><b>W{}</b></span>",
        "weekdays": "<span color='#F5F5F5'><b>{}</b></span>",
        "today": "<span color='#F5F5F5'><b><u>{}</u></b></span>",
      },
    },
  },
}
